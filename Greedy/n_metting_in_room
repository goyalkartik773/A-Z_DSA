#include<iostream>
#include<vector>
#include<queue>
using namespace std;
typedef pair<int,int> jiit;
class comparator{
public:
    bool operator()(pair<int,int> a,pair<int,int> b){
    return a.second > b.second; // minheap
    }
};
int total_meetings(vector<int>& start,vector<int>& endtime){
    // greedy approach pahela wo meeting karega jiska ending time minimum hoga
priority_queue<jiit,vector<jiit>,comparator> pq;
int n = start.size();
for(int i=0;i<n;i++){
    pq.push({start[i],endtime[i]});
}
int et = pq.top().second;
pq.pop();
int meetings = 1;
while(pq.size()!=0){
    int st = pq.top().first;
    if(st>et){
        meetings++;
        et = pq.top().second;
    }
    pq.pop();
}
return meetings;
}
int main(){
    vector<int> starttime = {1,3,0,5,8,5};
    vector<int> endtime = {2,4,6,7,9,9};
    cout<<total_meetings(starttime,endtime);

}
